# M-Pesa settings (not secret). Secrets go in with: firebase functions:secrets:set NAME
# Start in sandbox with Safaricom's test paybill 174379. When you go live, change these to your own.
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
# paybill or till
MPESA_TYPE=paybill
# For a till (Buy Goods): put the till number here and your store number in MPESA_SHORTCODE
MPESA_PARTYB=
